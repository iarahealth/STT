# Training image for Iara STT on CUDA 12.8 (NVIDIA TensorFlow 25.02).
# Exports the same TFLite graph the existing inference binaries load.
# Python 3.12 is the version shipped in this NGC container; TensorFlow has no
# 3.14 GPU wheel that still produces that graph.

FROM nvcr.io/nvidia/tensorflow:25.02-tf2-py3 AS kenlm-build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake libboost-system-dev \
        libboost-thread-dev libboost-program-options-dev \
        libboost-test-dev libeigen3-dev zlib1g-dev \
        libbz2-dev liblzma-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /code
COPY kenlm /code/kenlm
RUN cd /code/kenlm && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j $(nproc) || \
    ( \
        echo "ERROR: Failed to build KenLM." \
        echo "ERROR: Make sure you update the kenlm submodule on host before building this Dockerfile." \
        echo "ERROR: $ cd STT; git submodule update --init kenlm" \
        exit 1 \
    )

FROM nvcr.io/nvidia/tensorflow:25.02-tf2-py3
ENV DEBIAN_FRONTEND=noninteractive

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        wget \
        curl \
        libopus0 \
        libvorbisfile3 \
        libopusfile0 \
        libsndfile1 \
        sox \
        libsox-fmt-mp3 \
        python3-venv \
        python3-dev \
        build-essential \
        cmake && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /venv
ENV VIRTUAL_ENV=/venv
ENV PATH="/venv/bin:/usr/local/bin:$PATH"
ENV UV_SYSTEM_PYTHON=0
ENV UV_LINK_MODE=copy

WORKDIR /code

COPY native_client /code/native_client
COPY .git /code/.git
COPY training/iara_stt_training/VERSION /code/training/iara_stt_training/VERSION
COPY training/iara_stt_training/GRAPH_VERSION /code/training/iara_stt_training/GRAPH_VERSION

# Decoder C++ archives still compile; the wheel is built with `pip wheel`
# because `python setup.py` crashes on current setuptools (MinimalDistribution).
RUN uv pip install --python /venv/bin/python 'setuptools==69.5.1' wheel numpy
RUN cd native_client/ctcdecode && make NUM_PROCESSES=$(nproc) bindings
RUN uv pip install --python /venv/bin/python native_client/ctcdecode/dist/*.whl

COPY setup.py /code/setup.py
COPY VERSION /code/VERSION
COPY pyproject.toml /code/pyproject.toml
COPY MANIFEST.in /code/MANIFEST.in
COPY training /code/training
RUN mkdir -p /code/kenlm/build/
COPY --from=kenlm-build /code/kenlm/build/bin /code/kenlm/build/bin

# Pre-built native client tools
RUN LATEST_STABLE_RELEASE=$(curl "https://api.github.com/repos/iarahealth/STT/releases/latest" | python -c 'import sys; import json; print(json.load(sys.stdin)["tag_name"])') \
    bash -c 'curl -L https://github.com/iarahealth/STT/releases/download/${LATEST_STABLE_RELEASE}/native_client.tflite.Linux.tar.xz | tar -xJvf -'

# TensorFlow GPU is already in the NGC image; do not replace it from PyPI.
# --no-build-isolation uses the venv setuptools (uv's isolated env has no pkg_resources).
RUN DS_NODECODER=y DS_NOTENSORFLOW=y uv pip install --python /venv/bin/python --no-build-isolation --upgrade -e .
RUN uv pip install --python /venv/bin/python ruff

COPY . /code
RUN ./bin/run-ldc93s1.sh && rm -rf ~/.local/share/stt
